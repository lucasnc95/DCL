#!/bin/bash
#----------------------------------------------------------
# Job name
#PBS -N DCL

# Name of stdout output file
#PBS -o job_dcl.out

# Total number of nodes and MPI tasks/node requested
#PBS -l nodes=compute-3-3:ppn=16+compute-3-4:ppn=16+compute-3-6:ppn=16+compute-3-7:ppn=16

# Run time (hh:mm:ss) - 4.5 hours
#PBS -l walltime=04:30:00
#----------------------------------------------------------

# Change to submission directory
cd $PBS_O_WORKDIR

cat $PBS_NODEFILE
sort $PBS_NODEFILE | uniq > machines2
cat machines2

export LD_LIBRARY_PATH=/share/apps/AMDAPPSDK-3.0/lib/x86_64/:$LD_LIBRARY_PATH

# Launch profiling executable before the loops
/opt/ohpc/pub/mpi/mpich-ofi-gnu13-ohpc/3.4.3/bin/mpiexec -np 4 -machinefile machines2 ./profiling.out 

RESULT_FILE="resultados_testes.txt"
TMP_SUMMARY="tabela_resumo_temp.txt"

echo "Tabela de resultados:" > $RESULT_FILE
echo "NP | Iterations | Bloco | Média Desvio Padrão (s)" >> $RESULT_FILE
echo "" >> $RESULT_FILE
echo "---" >> $RESULT_FILE
echo "" >> $RESULT_FILE

> $TMP_SUMMARY

calcular_estatisticas() {
    awk '{
        sum+=$1; sumsq+=$1*$1; vals[NR]=$1 
    } END {
        mean = sum / NR; 
        stddev = sqrt((sumsq / NR) - (mean * mean)); 
        printf "%.4f %.4f", mean, stddev
    }'
}

for np in 1 2 4; do
    echo "Testes com -np $np:" >> $RESULT_FILE
    
    for iter in 1000 10000; do
        echo "    --iterations $iter --rebalance-interval 100:" >> $RESULT_FILE
        echo "        Balanceamento baseado em profiling" >> $RESULT_FILE
        > tempos_tmp.txt
        
        for run in {1..10}; do
            start_time=$(date +%s.%N)
            
            /opt/ohpc/pub/mpi/mpich-ofi-gnu13-ohpc/3.4.3/bin/mpiexec -np $np -machinefile machines2 \
            ./HIS.out \
            --x 50 --y 50 --z 6400 \
            --iterations $iter \
            --gather-final 0 \
            --balance-mode dynamic \
            --balance-strategy profiled \
            --rebalance-interval 100 \
            --profiling-file profiling_results.txt1
            
            end_time=$(date +%s.%N)
            
            elapsed=$(awk -v start=$start_time -v end=$end_time 'BEGIN {printf "%.4f", end - start}')
            echo "$elapsed" >> tempos_tmp.txt
            echo "            t$run: ${elapsed}s" >> $RESULT_FILE
        done
        
        stats=$(cat tempos_tmp.txt | calcular_estatisticas)
        media_prof=$(echo $stats | awk '{print $1}')
        desvio_prof=$(echo $stats | awk '{print $2}')
        echo "        Média e desvio padrão: ${media_prof}s ± ${desvio_prof}s" >> $RESULT_FILE
        
        echo "$np | $iter | Profiling | ${media_prof}s ± ${desvio_prof}s" >> $TMP_SUMMARY
        echo "        Balanceamento com threshold fixo" >> $RESULT_FILE
        > tempos_tmp.txt
        
        for run in {1..10}; do
            start_time=$(date +%s.%N)
            
            /opt/ohpc/pub/mpi/mpich-ofi-gnu13-ohpc/3.4.3/bin/mpiexec -np 4 -machinefile machines2 \
            ./HIS.out \
            --x 50 --y 50 --z 6400 \
            --iterations $iter \
            --gather-final 0 \
            --balance-mode dynamic \
            --balance-strategy threshold \
            --rebalance-interval 100 \
            --rebalance-threshold 0.0003125
            end_time=$(date +%s.%N)
            
            # Calculando tempo gasto
            elapsed=$(awk -v start=$start_time -v end=$end_time 'BEGIN {printf "%.4f", end - start}')
            echo "$elapsed" >> tempos_tmp.txt
            echo "            t$run: ${elapsed}s" >> $RESULT_FILE
        done
        
        stats=$(cat tempos_tmp.txt | calcular_estatisticas)
        media_thresh=$(echo $stats | awk '{print $1}')
        desvio_thresh=$(echo $stats | awk '{print $2}')
        echo "        Média e desvio padrão: ${media_thresh}s ± ${desvio_thresh}s" >> $RESULT_FILE
        
        echo "$np | $iter | Threshold | ${media_thresh}s ± ${desvio_thresh}s" >> $TMP_SUMMARY
        
    done
done

echo "" >> $RESULT_FILE
echo "---" >> $RESULT_FILE
echo "Tabela Resumo:" >> $RESULT_FILE
echo "NP | Iterations | Bloco | Média Desvio Padrão (s)" >> $RESULT_FILE
cat $TMP_SUMMARY >> $RESULT_FILE

rm -f tempos_tmp.txt $TMP_SUMMARY