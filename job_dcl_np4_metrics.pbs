#!/bin/bash
#----------------------------------------------------------
# Job name
#PBS -N DCL_NP4_METRICS

# Name of stdout output file
#PBS -o Results/job_dcl_np4_metrics.out

# Total number of nodes and MPI tasks/node requested
#PBS -l nodes=compute-3-3:ppn=8+compute-3-4:ppn=8+compute-3-6:ppn=8+compute-3-7:ppn=8

#PBS -l walltime=24:30:00
#----------------------------------------------------------

cd $PBS_O_WORKDIR

mkdir -p Results
mkdir -p Results/np4
mkdir -p Results/np4/summary
mkdir -p Results/np4/profiling

cat $PBS_NODEFILE
sort $PBS_NODEFILE | uniq > machines2
cat machines2

export LD_LIBRARY_PATH=/share/apps/AMDAPPSDK-3.0/lib/x86_64/:$LD_LIBRARY_PATH

MPIEXEC=/opt/ohpc/pub/mpi/mpich-ofi-gnu13-ohpc/3.4.3/bin/mpiexec
NP=4

X=50
Y=50
Z=3200
ITERATIONS=10000
FIRST_INTERVAL=100
REGULAR_INTERVAL=1000
RUNS=10

PROFILE_FILE="Results/np${NP}/profiling/profiling_np${NP}.txt"
SUMMARY_CSV="Results/np${NP}/summary/summary_np${NP}.csv"
SUMMARY_HTML="Results/np${NP}/summary/summary_np${NP}.html"

THRESHOLDS="0.0003125 0.01 0.1"
MODES="static dynamic"

echo "Running profiling for NP=${NP}"
$MPIEXEC -np $NP -machinefile machines2 ./profiling.out "$PROFILE_FILE"

sanitize_name() {
    echo "$1" | sed 's/\./p/g; s/-/m/g; s/+//g'
}

calc_stats_file() {
    awk '{
        x = $1 + 0.0
        sum += x
        sumsq += x * x
        n += 1
    } END {
        if (n > 0) {
            mean = sum / n
            var = (sumsq / n) - (mean * mean)
            if (var < 0) var = 0
            printf "%.9f,%.9f", mean, sqrt(var)
        } else {
            printf "0.000000000,0.000000000"
        }
    }' "$1"
}

calc_stats_col() {
    local file="$1"
    local col="$2"
    awk -F',' -v c="$col" '{
        if (NF >= c && $c != "") {
            x = $c + 0.0
            sum += x
            sumsq += x * x
            n += 1
        }
    } END {
        if (n > 0) {
            mean = sum / n
            var = (sumsq / n) - (mean * mean)
            if (var < 0) var = 0
            printf "%.9f,%.9f", mean, sqrt(var)
        } else {
            printf "0.000000000,0.000000000"
        }
    }' "$file"
}

write_html_from_csv() {
    local csv="$1"
    local html="$2"
    cat > "$html" <<'EOF'
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
body { font-family: Arial, sans-serif; margin: 20px; }
table { border-collapse: collapse; font-size: 13px; }
th { background: #1f4e79; color: white; padding: 6px 8px; border: 1px solid #d0d7de; position: sticky; top: 0; }
td { padding: 5px 8px; border: 1px solid #d0d7de; }
tr:nth-child(even) { background: #f6f8fa; }
tr:hover { background: #fff3cd; }
</style>
</head>
<body>
<table>
EOF
    awk -F',' 'NR==1 {
        print "<tr>"
        for (i=1; i<=NF; ++i) print "<th>" $i "</th>"
        print "</tr>"
        next
    }
    {
        print "<tr>"
        for (i=1; i<=NF; ++i) print "<td>" $i "</td>"
        print "</tr>"
    }' "$csv" >> "$html"
    cat >> "$html" <<'EOF'
</table>
</body>
</html>
EOF
}

echo "np,mode,strategy,threshold,iterations,first_interval,regular_interval,total_mean_s,total_std_s,compute_accum_mean_s,compute_accum_std_s,comm_accum_mean_s,comm_accum_std_s,balance_accum_mean_s,balance_accum_std_s,rebalance_apply_accum_mean_s,rebalance_apply_accum_std_s" > "$SUMMARY_CSV"

run_case() {
    local mode="$1"
    local strategy="$2"
    local threshold="$3"
    local threshold_label="$4"

    local case_name="${mode}_${strategy}_${threshold_label}"
    local case_dir="Results/np${NP}/${case_name}"
    local logs_dir="${case_dir}/logs"

    mkdir -p "$case_dir"
    mkdir -p "$logs_dir"

    local total_times_file="${case_dir}/total_execution_times.txt"
    local final_metrics_file="${case_dir}/final_metrics_by_run.csv"
    local run_summary_file="${case_dir}/run_summary.csv"

    : > "$total_times_file"
    echo "run_id,compute_accum_s,comm_accum_s,balance_accum_s,rebalance_apply_accum_s" > "$final_metrics_file"
    echo "run_id,total_time_s,metrics_file,timing_file,log_file" > "$run_summary_file"

    for run in $(seq 1 $RUNS); do
        local metrics_file="${case_dir}/metrics_run_${run}.csv"
        local timing_file="${case_dir}/total_time_run_${run}.txt"
        local log_file="${logs_dir}/run_${run}.out"

        rm -f "$metrics_file" "$timing_file" "$log_file"

        if [ "$strategy" = "threshold" ]; then
            $MPIEXEC -np $NP -machinefile machines2 ./HIS.out                 --x $X --y $Y --z $Z                 --iterations $ITERATIONS                 --gather-final 0                 --balance-mode "$mode"                 --balance-strategy threshold                 --rebalance-interval $REGULAR_INTERVAL                 --first-rebalance-interval $FIRST_INTERVAL                 --rebalance-threshold "$threshold"                 --profiling-file "$PROFILE_FILE"                 --timing-file "$timing_file"                 --metrics-file "$metrics_file"                 --metrics-run-id "$run"                 > "$log_file" 2>&1
        else
            $MPIEXEC -np $NP -machinefile machines2 ./HIS.out                 --x $X --y $Y --z $Z                 --iterations $ITERATIONS                 --gather-final 0                 --balance-mode "$mode"                 --balance-strategy profiled                 --rebalance-interval $REGULAR_INTERVAL                 --first-rebalance-interval $FIRST_INTERVAL                 --profiling-file "$PROFILE_FILE"                 --timing-file "$timing_file"                 --metrics-file "$metrics_file"                 --metrics-run-id "$run"                 > "$log_file" 2>&1
        fi

        local total_time="0"
        if [ -s "$timing_file" ]; then
            total_time=$(tail -n 1 "$timing_file" | awk '{print $1}')
        fi
        echo "$total_time" >> "$total_times_file"

        local final_line=""
        if [ -s "$metrics_file" ]; then
            final_line=$(awk -F',' 'NR > 1 {line=$0} END {print line}' "$metrics_file")
        fi

        if [ -n "$final_line" ]; then
            local compute_accum=$(echo "$final_line" | awk -F',' '{print $10}')
            local comm_accum=$(echo "$final_line" | awk -F',' '{print $11}')
            local balance_accum=$(echo "$final_line" | awk -F',' '{print $12}')
            local apply_accum=$(echo "$final_line" | awk -F',' '{print $13}')
            echo "$run,$compute_accum,$comm_accum,$balance_accum,$apply_accum" >> "$final_metrics_file"
        else
            echo "$run,0,0,0,0" >> "$final_metrics_file"
        fi

        echo "$run,$total_time,$metrics_file,$timing_file,$log_file" >> "$run_summary_file"
    done

    local total_stats=$(calc_stats_file "$total_times_file")
    local compute_stats=$(calc_stats_col "$final_metrics_file" 2)
    local comm_stats=$(calc_stats_col "$final_metrics_file" 3)
    local balance_stats=$(calc_stats_col "$final_metrics_file" 4)
    local apply_stats=$(calc_stats_col "$final_metrics_file" 5)

    echo "$NP,$mode,$strategy,$threshold,$ITERATIONS,$FIRST_INTERVAL,$REGULAR_INTERVAL,$total_stats,$compute_stats,$comm_stats,$balance_stats,$apply_stats" >> "$SUMMARY_CSV"
}

for mode in $MODES; do
    for threshold in $THRESHOLDS; do
        threshold_name=$(sanitize_name "$threshold")
        run_case "$mode" "threshold" "$threshold" "threshold_${threshold_name}"
    done

    run_case "$mode" "profiled" "-" "profiled"
done

write_html_from_csv "$SUMMARY_CSV" "$SUMMARY_HTML"
